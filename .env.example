# Public, browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
# Use either the legacy anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only to provision users from the admin UI.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Required only to run AI-assisted CV summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
