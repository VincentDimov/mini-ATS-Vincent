# Public, browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
# Use either the legacy anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for user provisioning and verified CV/maintenance operations.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Required only to run AI-assisted CV summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Trusted public application origin; never derived from form fields or Host headers.
SITE_URL=http://localhost:3000
# Server-only random secret, at least 32 characters, for POST /api/maintenance.
MAINTENANCE_SECRET=
